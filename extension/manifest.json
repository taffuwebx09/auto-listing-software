{
  "manifest_version": 3,
  "name": "Auto Listing - HodaHub Bridge",
  "version": "1.0.1",
  "description": "Connects Auto Listing to the HodaHub admin session in your browser.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.hodahub.in/*",
    "https://hodahub.in/*",
    "https://auto-listing-software-4sdi.vercel.app/*",
    "https://cdn.cartpe.shop/*",
    "https://api.cloudinary.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://auto-listing-software-4sdi.vercel.app/*"
      ],
      "js": [
        "auto-listing-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.hodahub.in/*",
        "https://hodahub.in/*"
      ],
      "js": [
        "hodahub-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}