{
  "manifest_version": 3,
  "name": "Auto Listing - HodaHub Bridge",
  "version": "1.0.2",
  "description": "Connect Auto Listing to your logged-in HodaHub admin session.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://hodahub.in/*","https://www.hodahub.in/*","https://auto-listing-software-4sdi.vercel.app/*","https://api.cloudinary.com/*","https://cdn.cartpe.shop/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches":["https://auto-listing-software-4sdi.vercel.app/*"],"js":["auto-listing-bridge.js"],"run_at":"document_start"},
    {"matches":["https://hodahub.in/*","https://www.hodahub.in/*"],"js":["hodahub-content.js"],"run_at":"document_idle"}
  ]
}